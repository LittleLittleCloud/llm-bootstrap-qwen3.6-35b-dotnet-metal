<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../native/attention-type-probe.metal" Link="attention-type-probe.metal" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../native/kernels.metal" Link="kernels.metal" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../native/build/libbootstrap_metal.dylib" Link="libbootstrap_metal.dylib" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="draft-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="model-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildNativeBridge" BeforeTargets="PrepareForBuild" Inputs="../../native/bridge.mm" Outputs="../../native/build/libbootstrap_metal.dylib">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../native/build.sh&quot;" />
  </Target>
</Project>
