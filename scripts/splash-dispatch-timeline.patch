+    void finish() { @autoreleasepool {
+        double end=timelineNowNs();NSMutableArray *events=[NSMutableArray new];
+        for(auto &e:dispatches)[events addObject:@{@"name":@(e.name.c_str()),@"lane":@"CPU dispatch",@"start_ns":@(e.start),@"duration_ns":@(e.end-e.start),@"command":@(sequence)}];
+        [events addObject:@{@"name":@"encode",@"lane":@"CPU encode",@"start_ns":@(start),@"duration_ns":@(commitStart-start),@"command":@(sequence)}];
+        double committed=commitEnd.load();
+        if(committed>commitStart)[events addObject:@{@"name":@"commitSubmission",@"lane":@"CPU commit",@"start_ns":@(commitStart),@"duration_ns":@(committed-commitStart),@"command":@(sequence)}];
+        for(auto c:commands)[events addObject:@{@"name":@"command",@"lane":@"GPU command",@"start_ns":@(c.GPUStartTime*1e9),@"duration_ns":@((c.GPUEndTime-c.GPUStartTime)*1e9),@"command":@(sequence)}];
+        auto record=@{@"sequence":@(sequence),@"start_ns":@(start),@"end_ns":@(end),@"events":events};
+        auto data=[NSJSONSerialization dataWithJSONObject:record options:0 error:nil];
+        static std::mutex mutex;std::lock_guard lock(mutex);
+        FILE *f=fopen(path.fileSystemRepresentation,"a");if(!f){perror("timeline output");abort();}
+        fwrite(data.bytes,1,data.length,f);fputc('\n',f);fclose(f);
+    }}
+};
+
+// Local diagnostic only: keep command boundaries and capture encoder intervals.
+struct CounterTrace {
+    id<MTLDevice> device;
+    NSMutableArray<id<MTLCounterSampleBuffer>> *samples;
+    NSMutableArray<NSString*> *names;
+    NSString *path;
+    MTLTimestamp cpu0=0,gpu0=0;
+    std::vector<id<MTLCommandBuffer>> commands;
+    uint64_t sequence;
+    CounterTrace(id<MTLDevice> d, size_t count, uint64_t seq):device(d),sequence(seq) {
+        path=[NSString stringWithUTF8String:getenv("SPLASH_COUNTER_TRACE_FILE")];
+        if(![d supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary])
+            throw MetalBackendError("Stage counter sampling unavailable");
+        samples=[NSMutableArray new];names=[NSMutableArray new];
+        id<MTLCounterSet> ts=nil;
+        for(id<MTLCounterSet> set in d.counterSets)if([set.name isEqualToString:MTLCommonCounterSetTimestamp])ts=set;
+        if(!ts)throw MetalBackendError("Timestamp counter set unavailable");
+        for(size_t offset=0;offset<count*2;offset+=4096) {
+            MTLCounterSampleBufferDescriptor *desc=[MTLCounterSampleBufferDescriptor new];
