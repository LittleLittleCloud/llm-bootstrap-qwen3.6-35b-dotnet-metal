+struct DispatchTimeline {
+    struct Event { std::string name; double start,end; };
+    NSString *path; uint64_t sequence; double start=timelineNowNs(),commitStart=0;
+    std::atomic<double> commitEnd{0};
+    std::vector<Event> dispatches;
