+    }
+    id<MTLComputeCommandEncoder> encoder(id<MTLCommandBuffer> command,std::string_view name,size_t index) {
+        [names addObject:[[NSString alloc] initWithBytes:name.data() length:name.size() encoding:NSUTF8StringEncoding]];
+        MTLComputePassDescriptor *pass=[MTLComputePassDescriptor computePassDescriptor];
+        pass.sampleBufferAttachments[0].sampleBuffer=samples[index*2/4096];
+        pass.sampleBufferAttachments[0].startOfEncoderSampleIndex=index*2%4096;
+        pass.sampleBufferAttachments[0].endOfEncoderSampleIndex=index*2%4096+1;
+        return [command computeCommandEncoderWithDescriptor:pass];
+    }
+    void finish() {
+        @autoreleasepool {
+            MTLTimestamp cpu1=0,gpu1=0;[device sampleTimestamps:&cpu1 gpuTimestamp:&gpu1];
+            if(cpu1<=cpu0 || gpu1<=gpu0){fprintf(stderr,"TRACE_ERROR invalid calibration\n");abort();}
+            double nsPerTick=double(cpu1-cpu0)/double(gpu1-gpu0);
+            NSMutableData *data=[NSMutableData new];
+            for(size_t first=0;first<names.count*2;first+=4096) {
+                auto part=[samples[first/4096] resolveCounterRange:NSMakeRange(0,std::min<size_t>(4096,names.count*2-first))];
+                if(part)[data appendData:part];
+            }
+            if(data.length!=names.count*2*sizeof(MTLCounterResultTimestamp)){fprintf(stderr,"TRACE_ERROR invalid resolution\n");abort();}
+            const auto *v=(const MTLCounterResultTimestamp*)data.bytes;
