+            for(size_t i=0;i<names.count;++i) {
+                uint64_t a=v[2*i].timestamp,b=v[2*i+1].timestamp;
+                if(a==MTLCounterErrorValue || b==MTLCounterErrorValue || b<a || a<gpu0 || b>gpu1){fprintf(stderr,"TRACE_ERROR invalid interval\n");abort();}
+                [events addObject:@{@"kernel":names[i],@"start_ns":@(double(cpu0)+double(a-gpu0)*nsPerTick),@"duration_ns":@(double(b-a)*nsPerTick)}];
+            }
+            double gpuMs=0;for(auto command:commands)gpuMs+=(command.GPUEndTime-command.GPUStartTime)*1000;
+            auto record=@{@"sequence":@(sequence),@"gpu_ms":@(gpuMs),@"command_buffers":@(commands.size()),@"events":events};
+            auto json=[NSJSONSerialization dataWithJSONObject:record options:0 error:nil];
+            static std::mutex mutex;std::lock_guard lock(mutex);
+            FILE *f=fopen(path.fileSystemRepresentation,"a");if(!f){fprintf(stderr,"TRACE_ERROR cannot write\n");abort();}
+            fwrite(json.bytes,1,json.length,f);fputc('\n',f);fclose(f);
+        }
+    }
+};
